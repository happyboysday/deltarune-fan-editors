{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deltaruneworks.local/schema/cues.json",
  "title": "DR Battle Editor — 演出指令字典",
  "description": "遭遇戰的演出指令（cue）完整參考：參數、預設值、是否阻塞、分類、範例，加上文字值格式與表達式可用名稱。這是「給 Agent 讀的說明書」，cues 的 JSON Schema 在 encounter.json 的 $defs 內。",
  "x-schema-version": "dr-battle-schema/1",
  "x-encounter-format": "dr-battle-encounter/1",
  "format": "dr-battle-cues/1",
  "categories": [
    {
      "id": "text",
      "name": "文字"
    },
    {
      "id": "actor",
      "name": "演員"
    },
    {
      "id": "audio",
      "name": "音效"
    },
    {
      "id": "camera",
      "name": "鏡頭"
    },
    {
      "id": "value",
      "name": "數值"
    },
    {
      "id": "flow",
      "name": "流程"
    }
  ],
  "commands": {
    "say": {
      "cmd": "say",
      "desc": "在下方文字框說一句話；打完字等玩家按 Z（打字中按 Z = 立即顯示全文）。",
      "category": "text",
      "blocking": true,
      "params": {
        "text": {
          "type": "text",
          "required": true,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "台詞；可用 \\n 換行。（必填） 可給字串或 {zh,en}。",
          "x-source-key": "cue.text"
        },
        "speaker": {
          "type": "text",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "說話者名稱（顯示在文字框上方；省略則不顯示）。 可給字串或 {zh,en}。",
          "x-source-key": "cue.speaker"
        },
        "portrait": {
          "type": "sprite",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "頭像 sprite 名（assets/index.json 的 sprite key）。",
          "x-source-key": "cue.portrait"
        },
        "speed": {
          "type": "number",
          "required": false,
          "default": 1,
          "values": null,
          "nullable": false,
          "desc": "打字速度，每秒幾個字（1 = 原始速度）。 預設：1。",
          "x-source-key": "cue.speed"
        },
        "voice": {
          "type": "sound",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "每個字播放的音效名（打字音）。",
          "x-source-key": "cue.voice"
        },
        "win": {
          "type": "bool",
          "required": false,
          "default": false,
          "values": null,
          "nullable": false,
          "desc": "這句就是勝利旁白：victory/spared 掛鉤裡有它時，引擎不再在掛鉤後補一句「你赢了！」（用來讓演出和勝利旁白同時進行，例如包在 parallel 裡） 預設：false。",
          "x-source-key": "cue.win"
        }
      },
      "example": {
        "cmd": "say",
        "speaker": "Susie",
        "text": "* 喂，你這顆亮晶晶的石頭。",
        "speed": 1
      }
    },
    "bubble": {
      "cmd": "bubble",
      "desc": "在某個演員旁邊冒出對話泡泡；預設等玩家按 Z 或逾時。",
      "category": "text",
      "blocking": true,
      "params": {
        "actor": {
          "type": "actor",
          "required": true,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "說話的演員（必填）",
          "x-source-key": "cue.actor"
        },
        "text": {
          "type": "text",
          "required": true,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "泡泡文字（必填） 可給字串或 {zh,en}。",
          "x-source-key": "cue.text"
        },
        "side": {
          "type": "enum",
          "required": false,
          "default": "auto",
          "values": [
            "left",
            "right",
            "auto"
          ],
          "nullable": false,
          "desc": "泡泡在演員的哪一側；auto = 依演員位置自動。 預設：\"auto\"。 可選：left / right / auto。",
          "x-source-key": "cue.side"
        },
        "speed": {
          "type": "number",
          "required": false,
          "default": 1,
          "values": null,
          "nullable": false,
          "desc": "打字速度（字/幀） 預設：1。",
          "x-source-key": "cue.speed"
        },
        "wait": {
          "type": "any",
          "required": false,
          "default": "input",
          "values": null,
          "nullable": false,
          "desc": "\"input\" 等玩家按 Z；或給秒數逾時自動關閉。 預設：\"input\"。",
          "x-source-key": "cue.wait"
        }
      },
      "example": {
        "cmd": "bubble",
        "actor": "rudinn",
        "text": "嘿嘿，\n準備好接招了嗎？",
        "side": "right",
        "wait": 2
      }
    },
    "move": {
      "cmd": "move",
      "desc": "把演員平滑移動到指定座標（可相對）。",
      "category": "actor",
      "blocking": true,
      "params": {
        "actor": {
          "type": "actor",
          "required": true,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "（必填）",
          "x-source-key": "cue.actor"
        },
        "x": {
          "type": "number",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "目標 x（省略 = 不動）",
          "x-source-key": "cue.x"
        },
        "y": {
          "type": "number",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "目標 y（省略 = 不動）",
          "x-source-key": "cue.y"
        },
        "relative": {
          "type": "bool",
          "required": false,
          "default": false,
          "values": null,
          "nullable": false,
          "desc": "x/y 是否為相對位移 預設：false。",
          "x-source-key": "cue.relative"
        },
        "duration": {
          "type": "number",
          "required": false,
          "default": 0.5,
          "values": null,
          "nullable": false,
          "desc": "補間秒數 預設：0.5。",
          "x-source-key": "cue.duration"
        },
        "ease": {
          "type": "ease",
          "required": false,
          "default": "quadOut",
          "values": null,
          "nullable": false,
          "desc": "補間曲線：linear / quadIn / quadOut / quadInOut / sineInOut / backOut。 預設：\"quadOut\"。",
          "x-source-key": "cue.ease"
        }
      },
      "example": {
        "cmd": "move",
        "actor": "rudinn",
        "x": 520,
        "y": 190,
        "duration": 0.6,
        "ease": "quadOut"
      }
    },
    "anim": {
      "cmd": "anim",
      "desc": "切換演員的動畫狀態（anims 的 key）或直接指定 sprite。",
      "category": "actor",
      "blocking": false,
      "params": {
        "actor": {
          "type": "actor",
          "required": true,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "（必填）",
          "x-source-key": "cue.actor"
        },
        "anim": {
          "type": "string",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "動畫狀態名（actors.<id>.anims 的 key），例如 idle / attack / hurt。",
          "x-source-key": "cue.anim"
        },
        "sprite": {
          "type": "sprite",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "直接指定 sprite（覆寫狀態），適合一次性特效。",
          "x-source-key": "cue.sprite"
        },
        "fps": {
          "type": "number",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "覆寫播放速度",
          "x-source-key": "cue.fps"
        },
        "loop": {
          "type": "bool",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "覆寫是否循環",
          "x-source-key": "cue.loop"
        },
        "waitEnd": {
          "type": "bool",
          "required": false,
          "default": false,
          "values": null,
          "nullable": false,
          "desc": "true 時等「非循環動畫」播完才繼續（適合攻擊動作）。 預設：false。",
          "x-source-key": "cue.waitEnd"
        }
      },
      "example": {
        "cmd": "anim",
        "actor": "rudinn",
        "anim": "hurt",
        "waitEnd": true
      }
    },
    "form": {
      "cmd": "form",
      "desc": "切換演員形態（actor.forms 的 key）；形態內未定義的動畫退回基礎 anims（SPEC-P2 §1）。",
      "category": "actor",
      "blocking": false,
      "params": {
        "actor": {
          "type": "actor",
          "required": true,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "要變身的演員（必填）",
          "x-source-key": "cue.actor"
        },
        "name": {
          "type": "string",
          "required": true,
          "default": null,
          "values": null,
          "nullable": true,
          "desc": "形態名（actor.forms 的 key）；null 切回基礎形態（必填）",
          "x-source-key": "cue.name"
        },
        "anim": {
          "type": "string",
          "required": false,
          "default": null,
          "values": null,
          "nullable": false,
          "desc": "切換後要播的動畫（省略 = 沿用目前動畫名，沒有就 idle）",
          "x-source-key": "cue.anim"
        }
      },
      "example": {
        "cmd": "form"
      }
    },

      "_test\\b",
      "_background",
      "_marker",
      "_highlight",
      "_hitbox",
      "_mask$",
      "_sample",
      "_(walk|run)_(down|left|right|up)"
    ],
    "bulletTagPattern": "bullet|shard|projectile|missile"
  }
}

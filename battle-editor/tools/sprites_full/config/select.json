{
  "format": "dr-sprites-full-select/1",
  "_comment": "A3 素材補拆選取清單。規則：globalExclude → rules（名稱正則，先符合者勝，帶 tags）→ enemy（家族展開 + 個別 sprite）。詳見 tools/sprites_full/README.md。",
  "chapters": ["ch1", "ch2", "ch3", "ch4", "ch5"],
  "chapterPriority": ["ch5", "ch4", "ch3", "ch2", "ch1"],
  "gameFps": 30,
  "dataWinTemplates": [
    "assets-official/04-game/{chapter}/data.win",
    "assets-official/04-game/chapter{chapterNum}/data.win",
    "assets-official/02-audio/DELTARUNE/chapter{chapterNum}_windows/data.win"
  ],
  "globalExclude": [
    "^ftex_",
    "^IMAGE_",
    "mask",
    "hitbox",
    "^bg_",
    "_whitebg$",
    "\\d{4,}$",
    "^spr_overworld_",
    "^spr_plat_",
    "_old\\d*$"
  ],
  "rules": [
    {
      "id": "party-battle",
      "tags": ["party"],
      "include": ["^spr_(krisb|susieb|ralseib|noelleb)_"],
      "exclude": []
    },
    {
      "id": "soul",
      "tags": ["soul"],
      "include": [
        "^spr_heart(?!enemy)",
        "^spr_dodgeheart",
        "^spr_soul",
        "^spr_spinheart",
        "^spr_greenheart",
        "^spr_gigaheart"
      ],
      "exclude": []
    },
    {
      "id": "menu-buttons",
      "tags": ["ui"],
      "include": ["^spr_bt(?!b01_)", "^spr_ja_bt"],
      "exclude": ["^spr_btb01_"]
    },
    {
      "id": "dialogue-box",
      "tags": ["ui"],
      "include": ["^spr_textbox_", "^spr_bubl$", "^spr_battlemsg$"],
      "exclude": []
    },
    {
      "id": "attack-bar",
      "tags": ["ui"],
      "include": [
        "^spr_attack",
        "^spr_press",
        "^spr_battletarget",
        "^spr_chartarget",
        "dashbar"
      ],
      "exclude": []
    },
    {
      "id": "damage-numbers",
      "tags": ["ui"],
      "include": ["^spr_numbersfont"],
      "exclude": []
    },
    {
      "id": "hp-tp-bars",
      "tags": ["ui"],
      "include": [
        "^spr_hpname$",
        "^spr_hpslash$",
        "^spr_hero_hp$",
        "^spr_queen_hp$",
        "^spr_tension",
        "^spr_tplogo$",
        "^spr_tiredmark$"
      ],
      "exclude": []
    },
    {
      "id": "battle-box",
      "tags": ["ui"],
      "include": ["^spr_battleblcon", "^spr_battleui", "^spr_spare", "^spr_defendbar"],
      "exclude": []
    },
    {
      "id": "battle-background",
      "tags": ["battlebg"],
      "include": ["^spr_battlebg", "^spr_dojo_battlebg"],
      "exclude": []
    }
  ],
  "enemy": {
    "_comment": "各章敵人戰鬥 sprite＝以 object 引用（obj_*_enemy / obj_*_boss / obj_*battle*）與動作命名（*_idle/_hurt/_spared/_defeated/_wounded/_clobbered）為種子，人工整理出的家族清單。家族展開＝<family> 本身或 <family>_*。",
    "families": [
      "spr_archer_pot",
      "spr_bell_enemy",
      "spr_berdlyb",
      "spr_bibliox",
      "spr_blockguy",
      "spr_bounce_shell",
      "spr_bounce_spear",
      "spr_bqueen",
      "spr_book",
      "spr_chainking",
      "spr_checkers",
      "spr_clubs",

  "events": {
    "desk": [
      {
        "op": "branch",
        "if": {
          "flag": "gate_open",
          "is": true
        },
        "then": [
          {
            "op": "say",
            "pages": [
              {
                "speaker": "值班员",
                "text": "我看过记录了。那扇门现在归你管。"
              }
            ]
          }
        ],
        "else": [
          {
            "op": "say",
            "pages": [
              {
                "speaker": "值班员",
                "text": "右边的哨兵正在加班。你可以过去碰它，也可以在这里按铃。"
              }
            ]
          },
          {
            "op": "choose",
            "question": "现在叫来折纸哨兵吗？",
            "options": [
              {
                "text": "按铃，开始值班测试",
                "actions": [
                  {
                    "op": "battle",
                    "battle": "gate_guard"
                  }
                ]
              },
              {
                "text": "我自己去找它",
                "actions": [
                  {
                    "op": "say",
                    "pages": [
                      {
                        "speaker": "值班员",
                        "text": "那就往右走。带一点耐心，纸会割手。"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "branch",
            "if": {
              "flag": "gate_open",
              "is": true
            },
            "then": [
              {
                "op": "say",
                "pages": [
                  {
                    "speaker": "值班员",
                    "text": "我把这次的结案方式记在值班单上了。"
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
    "paper_victory": [
      {
        "op": "flag",
        "id": "gate_open",
        "value": true
      },
      {
        "op": "show",
        "actor": "right_lamp",
        "value": true
      },
      {
        "op": "item",
        "id": "通行纸",
        "delta": 1
      },
      {
        "op": "say",
        "pages": [
          "＊ 折痕留在地上。你拾起一张通行纸。"
        ]
      }
    ],
    "paper_spared": [
      {
        "op": "flag",
        "id": "gate_open",
        "value": true
      },
      {
        "op": "show",
        "actor": "right_lamp",
        "value": true
      },
      {
        "op": "item",
        "id": "盖章值班单",
        "delta": 1
      },
      {
        "op": "say",
        "pages": [
          "＊ 哨兵盖上了「准时下班」的章，门灯亮了。"
        ]
      }
    ],
    "paper_defeat": [
      {
        "op": "say",
        "pages": [
          {
            "speaker": "值班员",
            "text": "还在值班室。纸片已扫干净，你可以再试。"
          }
        ]
      }
    ],
    "paper_flee": [
      {
        "op": "say",
        "pages": [
          "＊ 你回到原地。哨兵依然站在岗上。"
        ]
      }
    ],
    "locked": [
      {
        "op": "say",
        "pages": [
          "＊ 档案室没收到值班单。先找折纸哨兵。"
        ]
      }
    ],
    "receipt": [
      {
        "op": "branch",
        "if": {
          "flag": "gate_result",
          "is": "spared"
        },
        "then": [
          {
            "op": "say",
            "pages": [
              "＊ 档案写着：哨兵平安下班。"
            ]
          }
        ],
        "else": [
          {
            "op": "say",
            "pages": [
              "＊ 档案写着：障碍已清除。"
            ]
          }
        ]
      }
    ]
  }
}

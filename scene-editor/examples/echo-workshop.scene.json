  "events": {
    "foreman_chat": [
      {
        "op": "branch",
        "if": {
          "flag": "met"
        },
        "then": [
          {
            "op": "say",
            "pages": [
              {
                "speaker": "值班员",
                "text": "水道那扇门已经给你开好了。看见坏掉的东西，不要问。它们都在排练。"
              }
            ]
          }
        ],
        "else": [
          {
            "op": "say",
            "pages": [
              {
                "speaker": "值班员",
                "text": "工坊收到三份故障报告。巧了，三份都是我写的。",
                "portrait": "foremanFace"
              },
              {
                "speaker": "值班员",
                "text": "冷却水道有踏板，剧场有拍子，苗圃有一株拒绝长大的植物。带上钥匙和水壶。",
                "portrait": "foremanFace"
              }
            ]
          },
          {
            "op": "choose",
            "question": "工坊需要一位临时修理工。",
            "options": [
              {
                "text": "接下委托",
                "actions": [
                  {
                    "op": "flag",
                    "id": "commission",
                    "value": true
                  }
                ]
              },
              {
                "text": "先问加班费",
                "actions": [
                  {
                    "op": "say",
                    "pages": [
                      {
                        "speaker": "值班员",
                        "text": "当然有。两次赞美，记得找我报销。",
                        "portrait": "foremanFace"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "op": "item",
            "id": "铜钥匙",
            "delta": 1
          },
          {
            "op": "item",
            "id": "水壶",
            "delta": 1
          },
          {
            "op": "flag",
            "id": "met",
            "value": true
          },
          {
            "op": "checkpoint"
          }
        ]
      }
    ],
    "locked": [
      {
        "op": "say",
        "pages": [
          "＊ 门旁贴着一张便笺：钥匙在值班员手里。"
        ]
      }
    ],
    "valve_event": [
      {
        "op": "timer",
        "ticks": 12,
        "event": "valve_confirm"
      }
    ],
    "valve_confirm": [
      {
        "op": "say",
        "pages": [
          "＊ 铜箱压住踏板。水道闸门卡了一下，然后决定配合。"
        ]
      }
    ],
    "pressure_hint": [
      {
        "op": "say",
        "pages": [
          "＊ 门的指示灯没亮。把铜箱往右推上踏板。"
        ]
      }
    ],
    "rhythm_intro": [
      {
        "op": "branch",
        "if": {
          "flag": "badge"
        },
        "then": [
          {
            "op": "say",
            "pages": [
              "＊ 试音已通过。下次请把剧场搬得离水道远一点。"
            ]
          }
        ],
        "else": [
          {
            "op": "call",
            "event": "six_beats"
          }
        ]
      }
    ],
    "six_beats": {
      "type": "rhythm",
      "title": "回声试音 · 六拍",
      "lead": 30,
      "window": 4,
      "minHits": 5,
      "resultTicks": 28,
      "beats": [
        {
          "at": 0,
          "key": "left"
        },
        {
          "at": 24,
          "key": "up"
        },
        {
          "at": 48,
          "key": "act"
        },
        {
          "at": 72,
          "key": "right"
        },
        {
          "at": 96,
          "key": "down"
        },
        {
          "at": 120,
          "key": "act"
        }
      ],
      "onWin": "rhythm_pass",
      "onLose": "rhythm_retry"
    },
    "rhythm_pass": [
      {
        "op": "flag",
        "id": "badge",
        "value": true
      },
      {
        "op": "item",
        "id": "试音章",
        "delta": 1
      },
      {
        "op": "show",
        "actor": "stage_light",
        "value": true
      },
      {
        "op": "move",
        "actor": "stagehand",
        "x": 303,
        "y": 128,
        "ticks": 15
      },
      {
        "op": "wait",
        "ticks": 7
      },
      {
        "op": "say",
        "pages": [
          {
            "speaker": "提词员",
            "text": "合格。其实有一拍是我打喷嚏，但我们都当作没发生。"
          }
        ]
      }
    ],
    "rhythm_retry": [
      {
        "op": "say",
        "pages": [
          {
            "speaker": "提词员",
            "text": "没关系。亮线经过记号时再按键。再来一次，我把喷嚏忍住。"
          }
        ]
      }
    ],
    "stagehand_line": [
      {
        "op": "say",
        "pages": [
          {
            "speaker": "提词员",
            "text": "台上负责打拍子。台下负责假装拍子很准。"
          }
        ]
      }
    ],
    "need_beat": [
      {
        "op": "say",
        "pages": [
          "＊ 剧场出口需要一枚试音章。"
        ]
      }
    ],
    "no_water": [
      {
        "op": "say",
        "pages": [
          "＊ 种子很渴。你身上没有水壶。"
        ]
      }
    ],
    "water_begin": [
      {
        "op": "timer",
        "ticks": 22,
        "event": "water_finish",
        "global": true
      },
      {
        "op": "wait",
        "ticks": 9
      }
    ],
    "water_finish": [
      {
        "op": "flag",
        "id": "bloom",
        "value": true
      },
      {
        "op": "show",
        "actor": "sprout",
        "value": true
      },
      {
        "op": "item",
        "id": "苗圃签",
        "delta": 1
      },
      {
        "op": "say",
        "pages": [
          "＊ 芽破土了。它第一个学会的动作，是朝门口点头。"
        ]
      }
    ],
    "need_bloom": [
      {
        "op": "say",
        "pages": [
          "＊ 苗圃的值班牌还没挂上。对着花槽长按 Z。"
        ]
      }
    ],
    "unfinished": [
      {
        "op": "say",
        "pages": [
          "＊ 储物柜要求三张检查表。你还没有修完整座工坊。"
        ]
      }
    ],
    "finish": [
      {
        "op": "branch",
        "if": {
          "flag": "done"
        },
        "then": [
          {
            "op": "say",
            "pages": [
              "＊ 储物柜里只剩下安静。它终于学会了。"
            ]
          }
        ],
        "else": [
          {
            "op": "camera",
            "x": 520,
            "y": 155,
            "ticks": 18
          },
          {
            "op": "say",
            "pages": [
              "＊ 钥匙、试音章、苗圃签都对得上。",
              "＊ 值班灯熄灭了。下班。"
            ]
          },
          {
            "op": "show",
            "actor": "hub_lamp",
            "value": false
          },
          {
            "op": "flag",
            "id": "done",
            "value": true
          },
          {
            "op": "camera",
            "follow": true
          }
        ]
      }
    ]
  }
}
